# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Runner (via onesignal_flutter's own podspec dependency) and the
# OneSignalNotificationServiceExtension target below both vendor
# overlapping OneSignal XCFrameworks (OneSignalCore, OneSignalOutcomes,
# OneSignalExtension). Xcode's build system rejects that as "Multiple
# commands produce ...xcframework" unless CocoaPods' generated script
# build phases stop declaring explicit input/output paths for them —
# this is CocoaPods' own documented fix for that class of error.
install! 'cocoapods', :disable_input_output_paths => true

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

target 'OneSignalNotificationServiceExtension' do
  # Must match Runner's use_frameworks! setting — CocoaPods requires an
  # embedded target (the NSE) and its host app target to agree on this,
  # otherwise `pod install` fails with "do not both set use_frameworks!".
  use_frameworks!

  # The NSE only needs the lightweight OneSignalExtension subspec (Confirmed
  # Delivery, image attachments, action buttons) — not the full `OneSignal`
  # umbrella subspec, which is what Runner already links via onesignal_flutter
  # and would otherwise duplicate the same vendored XCFrameworks into both
  # targets. Pin to the exact OneSignal iOS / XCFramework Stable version from
  # https://onesignal.github.io/sdk-releases/releases.json — do not use a
  # version range.
  pod 'OneSignalXCFramework/OneSignalExtension', '5.5.1'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
