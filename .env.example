OPENAI_API_KEY=replace_with_a_new_key
# OPENAI_MODEL=gpt-4o-mini
# PORT=3000
# ALLOWED_ORIGIN=http://localhost:3000
# Contact form email, sent via Resend's HTTPS API (not SMTP — Render's free
# tier blocks outbound SMTP ports entirely, see the comment above
# sendContactEmail() in server.js). Get a key at https://resend.com/api-keys.
# RESEND_API_KEY=re_replace_with_your_resend_key
# Defaults to Resend's shared onboarding@resend.dev sender, which only
# delivers to the email address that owns the Resend account. Set this
# (to an address on a domain you've verified in Resend) if CONTACT_RECIPIENT
# is ever not that same account-owner address.
# RESEND_FROM=DreamAI <onboarding@resend.dev>
# CONTACT_RECIPIENT=a.yasiny.yilmaz@gmail.com

# Monetization: free-tier and subscribed monthly dream limits.
# FREE_DREAM_LIMIT=3
# MONTHLY_DREAM_LIMIT=50
# Shared secret set as the "Authorization header value" in the RevenueCat
# webhook dashboard, so /revenuecat-webhook can reject spoofed requests.
# REVENUECAT_WEBHOOK_AUTH=replace_with_a_random_secret
# RevenueCat secret API key (Project settings > API keys > Secret key,
# starts with "sk_"). Lets /analyze double-check entitlement status
# directly with RevenueCat when a device looks over its free quota but the
# webhook hasn't (yet) marked it subscribed locally. Optional but
# recommended — without it, a missed/late webhook can wrongly paywall a
# paying customer until their next renewal event.
# REVENUECAT_SECRET_API_KEY=sk_replace_with_your_secret_key
# Maps one-time credit-pack product ids (created in App Store
# Connect/Play Console and added to RevenueCat as Non-Subscription
# products) to how many bonus dream interpretations each grants. See the
# "One-time credit packs" section in README.md.
# CREDIT_PRODUCT_MAP={"dreamai_credits_10":10,"dreamai_credits_30":30,"dreamai_credits_100":100}

# Usage database (per-device quota state).
# Leave both unset for local dev: falls back to a local SQLite file
# (USAGE_DB_PATH, defaults to ./usage.db). Set TURSO_DATABASE_URL (+
# TURSO_AUTH_TOKEN) to point at a Turso database instead — required on
# hosts with an ephemeral filesystem (e.g. Render's free tier), where a
# local file would reset on every redeploy/restart.
# USAGE_DB_PATH=./usage.db
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=replace_with_your_turso_token
